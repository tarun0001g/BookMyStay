<%- include('../partials/header') %>
<body class="bg-gray-100 min-h-screen flex flex-col">
<%- include('../partials/nav') %>
<main class="max-w-5xl mx-auto w-full p-6 flex-grow">
  <h1 class="text-3xl font-bold text-gray-800 mb-6">My Bookings</h1>
  <% if (!bookings.length) { %><p class="bg-white rounded p-6 text-gray-600">You have no bookings yet.</p><% } %>
  <div class="space-y-4"><% bookings.forEach(booking => { if (booking.home) { %>
    <article class="bg-white rounded-xl shadow p-5 flex flex-col sm:flex-row gap-4">
      <img class="w-full sm:w-40 h-32 object-cover rounded" src="<%= booking.home.photo %>" alt="<%= booking.home.houseName %>">
      <div class="flex-grow"><h2 class="text-xl font-bold"><%= booking.home.houseName %></h2><p><%= booking.checkIn.toLocaleDateString() %> – <%= booking.checkOut.toLocaleDateString() %></p><p><%= booking.nights %> nights · <%= booking.guests %> guests · ₹<%= booking.totalPrice %></p><p>Status: <%= booking.status %></p></div>
      <% if (booking.status === 'confirmed' && booking.checkIn >= new Date(new Date().setHours(0,0,0,0))) { %><form method="POST" action="/bookings/<%= booking._id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="bg-rose-500 text-white rounded px-4 py-2">Cancel</button></form><% } %>
    </article>
  <% } }) %></div>
</main>
<%- include('../partials/footer') %>
</body></html>
