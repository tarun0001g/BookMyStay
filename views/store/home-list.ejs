
<%- include("../partials/header") %>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col">

    <!-- ✅ Navbar Added -->
<%- include("../partials/nav") %>

  <!-- ✅ Hero Section -->
  <section class="text-center mt-12 px-4">
    <h2 class="text-4xl font-extrabold text-gray-800 mb-3">
      Find Your Perfect Stay
    </h2>

    <p class="text-gray-500 text-lg">
      Discover beautiful homes and amazing experiences.
    </p>
  </section>

  <!-- ✅ Listings Section -->
  <main class="flex-grow max-w-7xl mx-auto px-6 py-10">

    <h3 class="text-2xl font-bold text-gray-800 mb-6">
      Available Homes
    </h3>
    <form method="GET" action="/homes" class="mb-6 flex flex-wrap gap-3">
      <input name="q" value="<%= query.q || '' %>" placeholder="Name or location" class="border rounded px-3 py-2">
      <input name="minPrice" type="number" min="0" value="<%= query.minPrice || '' %>" placeholder="Min price" class="border rounded px-3 py-2">
      <input name="maxPrice" type="number" min="0" value="<%= query.maxPrice || '' %>" placeholder="Max price" class="border rounded px-3 py-2">
      <select name="sort" class="border rounded px-3 py-2"><option value="price" <%= query.sort !== 'rating' ? 'selected' : '' %>>Price</option><option value="rating" <%= query.sort === 'rating' ? 'selected' : '' %>>Rating</option></select>
      <button class="bg-rose-500 text-white rounded px-4 py-2">Search</button>
    </form>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">

      <% if (registeredHomes.length === 0) { %>
        <p class="text-gray-500">No homes added yet.</p>
      <% } %>

      <% registeredHomes.forEach(home => { %>
        <!-- Card -->
        <div class="bg-white rounded-lg shadow-md hover:shadow-2xl transition-all duration-300 overflow-hidden hover:scale-105">
          <!-- Image -->
          <div class="h-48 bg-gray-300 overflow-hidden">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-full object-cover">
          </div>
          
          <div class="p-5">
            <!-- Name -->
            <h4 class="text-xl font-bold text-gray-800 mb-2">
              <%= home.houseName %>
            </h4>
            
            <!-- Location -->
            <p class="text-sm text-gray-600 mb-3 flex items-center">
              📍 <%= home.location %>
            </p>
            
            <div >
              <!-- Rating -->
            <p class="text-sm text-yellow-500 font-semibold mb-4">
              ⭐ <%= home.rating %>/5 Rating
            </p>
            
            <!-- Price -->
            <p class="text-2xl font-bold text-rose-500 mb-4">
              ₹<%= home.price %> <span class="text-sm text-gray-500 font-normal">/night</span>
            </p>
            </div>
            
            <!-- Buttons -->
            <div class="flex gap-3">
              <a href="/homes/<%= home._id %>" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg font-semibold transition-colors p-2 pl-5"  >
                View Details
              </a>
              <a href="/homes/<%= home._id %>" class="flex-1 bg-rose-500 hover:bg-rose-600 text-white py-2 rounded-lg font-semibold transition-colors text-center">
                Book Now
              </a>
               <%- include("../partials/favourite", {home: home}) %>
            </div>
          </div>
        </div>
      <% }) %>

    </div>
    <% const params = new URLSearchParams({ ...query, page: String(page) }); %>
    <div class="flex justify-between mt-8"><% if (page > 1) { %><a class="text-rose-600" href="/homes?<%= new URLSearchParams({ ...query, page: String(page - 1) }) %>">Previous</a><% } else { %><span></span><% } %><span>Page <%= page %> of <%= pages %></span><% if (page < pages) { %><a class="text-rose-600" href="/homes?<%= new URLSearchParams({ ...query, page: String(page + 1) }) %>">Next</a><% } %></div>

  </main>

  <!-- ✅ Footer -->
<%- include("../partials/footer") %>

</body>
</html>


