
<%- include("../partials/header") %>
</head>
<body class="bg-gray-50 min-h-screen flex flex-col">

  <%- include("../partials/nav") %>

  <section class="min-h-[calc(100vh-4rem)] py-8 px-4 md:px-6 lg:px-8">
    <div class="max-w-6xl mx-auto">

      <nav class="text-sm text-gray-500 mb-6">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a> / <span class="text-gray-700">Property Details</span>
      </nav>

      <div class="grid lg:grid-cols-[1.6fr_1fr] gap-8 items-start">

        <div>
          <div class="bg-white rounded-3xl overflow-hidden shadow-xl h-72 md:h-80 lg:h-96">
            <img src="<%= home.photo %>" alt="<%= home.houseName %>" class="w-full h-full object-cover object-center transition-transform duration-300 hover:scale-105">
          </div>
        </div>

        <div class="bg-white rounded-3xl shadow-xl p-6 lg:p-8 border border-gray-200">
          <h1 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-4">
            <%= home.houseName %>
          </h1>

          <div class="flex flex-wrap items-center gap-3 mb-5 pb-4 border-b border-gray-200">
            <div class="flex items-center gap-1 text-yellow-400">
              <% for (let i = 0; i < Math.floor(home.rating); i++) { %>
                <span class="text-base">⭐</span>
              <% } %>
            </div>
            <span class="font-medium text-gray-800 text-sm"><%= home.rating %>/5</span>
            <span class="text-gray-500 text-sm">(Based on reviews)</span>
          </div>

          <div class="grid gap-5 mb-5">
            <div>
              <p class="text-gray-500 text-xs uppercase tracking-[0.2em] mb-2">Location</p>
              <p class="text-gray-800 font-medium text-base flex items-center gap-2">
                <span class="text-red-500">📍</span><%= home.location %>
              </p>
            </div>

            <div>
              <p class="text-gray-500 text-xs uppercase tracking-[0.2em] mb-2">Price per night</p>
              <p class="text-3xl font-bold text-rose-500">
                ₹<%= home.price %>
              </p>
              <p class="text-sm text-gray-600 mt-1">Includes taxes and fees</p>
            </div>
          </div>

          <div class="mb-5 pb-5 border-b border-gray-200">
            <p class="text-gray-500 text-xs uppercase tracking-[0.2em] mb-3">Description</p>
            <p class="text-gray-700 leading-relaxed text-sm md:text-base">
              <%= home.description %>
            </p>
          </div>

          <div class="space-y-3 mt-5">
            <button class="w-full bg-rose-500 hover:bg-rose-600 text-white py-3 rounded-2xl font-semibold transition-all duration-300 shadow-md">
              Book Now
            </button>

            <%- include("../partials/favourite") %>

            <a
              href="/rules/<%= home._id %>"
              class="block w-full text-center bg-blue-600 hover:bg-blue-700 text-white py-3 rounded-2xl font-semibold transition-all duration-300 shadow-md"
            >
              📄 Download House Rules
            </a>
          </div>
        </div>

      </div>

    </div>
  </section>

</body>
</html>

